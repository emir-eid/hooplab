{
  "name": "hooplab",
  "private": true,
  "type": "module",
  "description": "Kişisel baseline'a ve bilimsel kaynaklara dayanan sporcu performans uygulaması (Expo + Supabase).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "guard": "node tools/guard/privacy-guard.mjs --staged",
    "guard:all": "node tools/guard/privacy-guard.mjs --all",
    "guard:history": "node tools/guard/privacy-guard.mjs --history",
    "backup": "node tools/backup/backup-private.mjs",
    "research:check": "node tools/research/validate-sources.mjs",
    "research:check:online": "node tools/research/validate-sources.mjs --online",
    "check": "npm run test:tools && npm run guard:all && npm run guard:history && npm run research:check"
  }
}
