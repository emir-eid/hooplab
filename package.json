{
  "name": "hooplab",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Kişisel baseline'a ve bilimsel kaynaklara dayanan sporcu performans uygulaması (Expo + Supabase).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "hooks:install": "git config core.hooksPath .githooks",
    "setup": "node tools/setup/setup.mjs",
    "setup:check": "node tools/setup/setup.mjs --check",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "guard": "node tools/guard/privacy-guard.mjs --staged",
    "guard:all": "node tools/guard/privacy-guard.mjs --all",
    "guard:history": "node tools/guard/privacy-guard.mjs --history",
    "backup": "node tools/backup/backup-private.mjs",
    "research:check": "node tools/research/validate-sources.mjs",
    "research:check:online": "node tools/research/validate-sources.mjs --online",
    "research:kb": "node tools/research/coach-kb.mjs",
    "coach:usage": "node tools/coach-usage/report.mjs",
    "check": "npm run test:tools && npm run typecheck && npm run test:packages && npm run test:apps && npm run test:functions && npm run guard:all && npm run guard:history && npm run research:check",
    "typecheck": "tsc -p packages/theme && tsc -p packages/theme/tsconfig.test.json && tsc -p packages/engine && tsc -p packages/engine/tsconfig.test.json && tsc -p apps/mobile && tsc -p apps/mobile/tsconfig.test.json && tsc -p supabase/functions && tsc -p supabase/functions/tsconfig.test.json && tsc -p e2e",
    "test:packages": "node --test \"packages/**/*.test.ts\"",
    "test:apps": "node --test \"apps/mobile/src/**/*.test.ts\"",
    "mobile": "npm run start -w @hooplab/mobile",
    "mobile:tunnel": "node tools/dev/mobile-tunnel.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "eas": "node tools/dev/eas.mjs",
    "web:local": "node tools/dev/web-local.mjs",
    "screenshots": "node tools/dev/demo-screenshots.mjs",
    "site": "node tools/site/build-site.mjs",
    "db:start": "supabase start -x studio,imgproxy,realtime,storage-api,edge-runtime,logflare,vector,supavisor,mailpit,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:functions": "node --test \"supabase/functions/tests/**/*.test.ts\""
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@playwright/test": "1.63.0",
    "@supabase/server": "1.9.0",
    "@types/node": "~24.19.1",
    "supabase": "2.119.0",
    "typescript": "~6.0.3"
  }
}
