#!/bin/sh
# HoopLab pre-push: araç testleri, tip denetimi, paket testleri, tüm repo gizlilik taraması ve kaynak
# doğrulaması geçmeden push yok. Uygulamanın (apps/mobile) tip denetimi ve testleri dahil.

if ! command -v node >/dev/null 2>&1; then
  echo "[pre-push] node bulunamadı; kontroller koşamadı. Push durduruldu." >&2
  exit 1
fi

if [ ! -x node_modules/.bin/tsc ]; then
  echo "[pre-push] node_modules yok; tip denetimi koşamadı. 'npm install' çalıştır. Push durduruldu." >&2
  exit 1
fi

node --test "tools/**/*.test.mjs" &&
  node_modules/.bin/tsc -p packages/theme &&
  node_modules/.bin/tsc -p packages/theme/tsconfig.test.json &&
  node_modules/.bin/tsc -p apps/mobile &&
  node_modules/.bin/tsc -p apps/mobile/tsconfig.test.json &&
  node --test "packages/**/*.test.ts" &&
  node --test "apps/mobile/src/**/*.test.ts" &&
  node tools/guard/privacy-guard.mjs --all &&
  node tools/guard/privacy-guard.mjs --history &&
  node tools/research/validate-sources.mjs || {
  echo "[pre-push] Push durduruldu: kontrollerden biri kırmızı." >&2
  exit 1
}
