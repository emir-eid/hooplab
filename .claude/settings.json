{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "expo-plugins": {
      "source": { "source": "github", "repo": "expo/skills" }
    },
    "supabase-agent-skills": {
      "source": { "source": "github", "repo": "supabase/agent-skills" }
    }
  },
  "enabledPlugins": {
    "expo@expo-plugins": true,
    "supabase@supabase-agent-skills": true,
    "postgres-best-practices@supabase-agent-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/session-start.mjs\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/archive-transcript.mjs\" precompact",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/hooks/archive-transcript.mjs\" sessionend",
            "shell": "bash",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/backup/backup-private.mjs\" --quiet",
            "shell": "bash",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
